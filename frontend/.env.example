# Optional Supabase Database Configuration
# If left blank, GameGauge seamlessly uses fast local-first browser storage (no setup required)
# To connect your Supabase project:
# 1. Create a free project on https://supabase.com
# 2. Copy Project URL and Anon Public Key from Settings -> API
# 3. Paste them below and rename this file to .env

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
